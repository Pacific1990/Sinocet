# Development only: never commit a populated .env
NODE_ENV=development
SMTR_PORT=4010
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sinocet_smtr
DB_USER=smtr_app
DB_PASSWORD=
# Exactly 64 hex characters; required to encrypt Director/Administrator TOTP secrets at rest.
SMTR_TOTP_ENCRYPTION_KEY=
# Optional allowed Origin for a separate frontend domain; same-origin recommended.
SMTR_ALLOWED_ORIGIN=
