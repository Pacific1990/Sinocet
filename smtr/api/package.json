{
  "name": "@sinocet/smtr-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/server.mjs && node --check src/app.mjs && node --check src/auth.mjs && node --check src/stock.mjs && node --check src/transfers.mjs && node --check scripts/provision.mjs"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
